<Window x:Class="Wypożyczalnia_Nart.NewRentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wypożyczalnia_Nart"
        mc:Ignorable="d"
        Title="NewRentalWindow" Height="300" Width="400">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Nowe Wypożyczenie" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Label Content="Imię i Nazwisko:"/>
            <TextBox Name="txtName" Width="200"/>

            <Label Content="Sprzęt:"/>
            <ComboBox Name="cbEquipment" Width="200">
                <ComboBoxItem Content="Narty"/>
                <ComboBoxItem Content="Snowboard"/>
                <ComboBoxItem Content="Kije"/>
            </ComboBox>

            <Button Content="Zatwierdź" Margin="10" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
