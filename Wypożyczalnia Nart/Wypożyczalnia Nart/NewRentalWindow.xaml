<Window x:Class="Wypożyczalnia_Nart.NewRentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wypożyczalnia_Nart"
        mc:Ignorable="d"
        Title="NewRentalWindow" Height="800" Width="600">

    <Window.Resources>
        <!-- Styl dla etykiet -->
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- Styl dla TextBoxów i ComboBoxów -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>

        <!-- Styl dla TextBlocków -->
        <Style x:Key="TextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <!-- Styl dla przycisku -->
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Styl dla okna -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="140,45,140,44">

            <TextBlock Text="Nowe Wypożyczenie" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Label Content="Imię i Nazwisko:" Style="{StaticResource LabelStyle}"/>
            <TextBox Name="txtName" Style="{StaticResource InputStyle}" Width="200"/>

            <Label Content="Sprzęt:" Style="{StaticResource LabelStyle}"/>
            <ComboBox Name="cbEquipment" Style="{StaticResource ComboBoxStyle}" Width="200" SelectionChanged="cbEquipment_SelectionChanged"/>

            <Label Content="Długość:" Style="{StaticResource LabelStyle}"/>
            <TextBlock Name="txtLength" Style="{StaticResource TextBlockStyle}" Width="200"/>

            <Label Content="Cena:" Style="{StaticResource LabelStyle}"/>
            <TextBlock Name="txtPrice" Style="{StaticResource TextBlockStyle}" Width="200"/>

            <Label Content="Opis:" Style="{StaticResource LabelStyle}"/>
            <TextBlock Name="txtDescription" Style="{StaticResource TextBlockStyle}" Width="200" TextWrapping="Wrap"/>

            <Button Content="Zatwierdź" Style="{StaticResource ButtonStyle}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
