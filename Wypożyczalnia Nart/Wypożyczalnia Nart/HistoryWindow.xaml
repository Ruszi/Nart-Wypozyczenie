<Window x:Class="Wypożyczalnia_Nart.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wypożyczalnia_Nart"
        mc:Ignorable="d"
        Title="Historia wypożyczeń" Height="450" Width="600">

    <Window.Resources>
        <!-- Styl dla DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowBackground" Value="#FFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F0F0F0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Styl dla przycisku -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Padding" Value="6"/>
            <!-- Mniejsze wypełnienie -->
            <Setter Property="FontSize" Value="11"/>
            <!-- Mniejsza czcionka -->
            <Setter Property="Background" Value="Orange"/>
            <!-- Zmieniony kolor -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="70"/>
            <!-- Mniejsza szerokość -->
            <Setter Property="Height" Value="30"/>
            <!-- Niższy przycisk -->
        </Style>

    </Window.Resources>

    <DockPanel>
        <!-- DataGrid -->
        <DataGrid Name="HistoryDataGrid" DockPanel.Dock="Top" Height="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="*"/>
                <DataGridTextColumn Header="Klient" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Sprzęt" Binding="{Binding EquipmentName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
            <Button Content="Wyczyść osierocone wpisy" Style="{StaticResource BackButtonStyle}" Width="180" Click="CleanOrphaned_Click"/>
            <Button Content="Powrót" Style="{StaticResource BackButtonStyle}" Click="BackButton_Click" Margin="10,0,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
