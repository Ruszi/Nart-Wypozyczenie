<Window x:Class="Wypożyczalnia_Nart.equipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wypożyczalnia_Nart"
        mc:Ignorable="d"
        Title="Sprzęt narciarski" Height="450" Width="650"
        Background="#FFF8F9FA" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Styl dla przycisków -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla ListBox -->
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="🗂️ Lista Sprzętu" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"
                       Foreground="#FF2D2D2D"/>

            <DataGrid Name="EquipmentDataGrid"
          AutoGenerateColumns="False"
          ItemsSource="{Binding}"
          CanUserAddRows="False"
          IsReadOnly="True"
          SelectionMode="Single"
          HeadersVisibility="Column"
          Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Długość (cm)" Binding="{Binding Length}" Width="Auto" />
                    <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="2*" />
                    <DataGridTextColumn Header="Cena (zł)" Binding="{Binding Price}" Width="Auto" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                    <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Dodaj" Click="Add_Click"/>
                <Button Content="Usuń" Click="Remove_Click"/>
                <Button Content="Zamknij" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
