<Window x:Class="Wypożyczalnia_Nart.ReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wypożyczalnia_Nart"
        mc:Ignorable="d"
        Title="Zwrot sprzętu" Height="400" Width="600" Background="#F5F5F5">

    <Window.Resources>
        <!-- Styl przycisku (fioletowy, bez rozmycia) -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#8000FF"/>
            <!-- Fioletowy -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl ComboBox -->
        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Padding="20" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" 
                HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" Width="400">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" >
                <TextBlock Text="Wybierz wypożyczenie do zwrotu:" 
                           Margin="0,0,0,10" FontWeight="Bold" FontSize="16" TextAlignment="Center"/>

                <ComboBox x:Name="cbRentalHistory" Style="{StaticResource ModernComboBox}"
                          SelectionChanged="cbRentalHistory_SelectionChanged"/>

                <TextBlock x:Name="txtCustomerName" FontSize="14" Margin="0,10,0,0" TextAlignment="Center"/>

                <Button Content="Zwróć sprzęt" Style="{StaticResource ModernButton}" 
                        Margin="0,20,0,0" Click="Return_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
