<Window x:Class="Wypożyczalnia_Nart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Wypożyczalnia Nart" Height="550" Width="800" Background="#f0f4f8" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Background="White" CornerRadius="20" Padding="40" Width="500"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Wypożyczalnia Nart" FontSize="32" FontWeight="Bold"
                           Foreground="#2c3e50" HorizontalAlignment="Center" Margin="0,0,0,20"
                           Grid.Row="0"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button Content="Zarządzanie sprzętem" Height="50" Margin="0,10"
                            Background="#5DADE2" Foreground="White" FontWeight="SemiBold" FontSize="16"
                            BorderThickness="0" Click="Equipment_Click" Cursor="Hand"/>

                    <Button Content="Nowe wypożyczenie" Height="50" Margin="0,10"
                            Background="#1A6F6F" Foreground="White" FontWeight="SemiBold" FontSize="16"
                            BorderThickness="0" Click="NewRental_Click" Cursor="Hand"/>

                    <Button Content="Historia wypożyczeń" Height="50" Margin="0,10"
                            Background="#4A6572" Foreground="White" FontWeight="SemiBold" FontSize="16"
                            BorderThickness="0" Click="History_Click" Cursor="Hand"/>

                    <Button Content="Zwrot sprzętu" Height="50" Margin="0,10"
                            Background="#6C4F80" Foreground="White" FontWeight="SemiBold" FontSize="16"
                            BorderThickness="0" Click="Return_Click" Cursor="Hand"/>
                </StackPanel>

                <Button Content="Zamknij" Height="30" Width="150" Margin="0,20,20,0"
        Background="#E74C3C" Foreground="White" FontWeight="SemiBold" FontSize="16"
        BorderThickness="0" Click="Close_Click" Cursor="Hand" Grid.Row="2" HorizontalAlignment="Right"/>

            </Grid>
        </Border>
    </Grid>
</Window>
